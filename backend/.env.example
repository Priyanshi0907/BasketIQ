# BasketIQ Backend Environment Configuration
# Copy this file to .env and fill in real values before running.
# Never commit your actual .env file.

PROJECT_NAME="BasketIQ API"
ENVIRONMENT="development"

# Generate a real secret before deploying, e.g.: openssl rand -hex 32
# Do NOT reuse the placeholder below outside of local development.
SECRET_KEY="CHANGE_ME_INSECURE_DEFAULT_DO_NOT_USE_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL="sqlite:///./data/basketiq.db"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
